---
import { SITE_URL } from "astro:env/client";

interface NavItem {
    label: string;
    href: string;
}

const navItems: NavItem[] = [
    { label: "Home", href: SITE_URL },
    { label: "Archives", href: `${SITE_URL}/archives` },
    { label: "Feed", href: `${SITE_URL}/feed` },
];

const currentPath = Astro.url.pathname;
---

<nav class="site-nav" aria-label="nav bar">
    <ul class="nav-list">
        {navItems.map((item) => {
            const isActive = currentPath === new URL(item.href).pathname;
            return (
                <li class="nav-item">
                    {isActive ? (
                        <a
                            class="nav-link is-disabled"
                            aria-current="page"
                            aria-disabled="true"
                        >
                            {item.label}
                        </a>
                    ) : (
                        <a href={item.href} class="nav-link">
                            {item.label}
                        </a>
                    )}
                </li>
            );
        })}
    </ul>
</nav>

<style>
    .site-nav {
        display: flex;
        justify-content: center;
        padding: 1rem 1.25rem;
    }

    .nav-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav-link {
        text-decoration: none;
    }

    .nav-link.is-disabled {
        pointer-events: none;
        cursor: default;
        user-select: none;
    }
</style>
