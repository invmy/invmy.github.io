---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <MetaPage slot="head" />
  <dictionary-entry>
    <h1>do·trade</h1>
    <etymology-span>
      <ipa-span>/duː treɪd/</ipa-span>
      v. & n. [Eng. <i>do</i> + <i>trade</i>, lit. to execute transactions with discipline, strategy, and risk control; ref: <i>dotra.de</i>]
    </etymology-span>
    <ol>
      <li>
        (v.) to systematically execute financial market transactions based on rigorous analysis and risk management (<i>learning when to do trade and when to wait</i>).
      </li>
      <li>
        (n.) a dedicated hub and platform for modern traders to explore market dynamics, trading systems, and execution insights (<i>welcome to dotra.de</i>).
      </li>
    </ol>
    <hr>
    <prose-content>
      <p>
        <strong>dotra.de</strong> is a minimal, content-focused platform tailored for traders. It provides insights into trading psychology, market strategies, and risk management systems.
      </p>
      <p>
        Explore our latest articles, market breakdowns, and trading resources to build your edge in the market.
      </p>
    </prose-content>
  </dictionary-entry>
</Layout>

<style>
  dictionary-entry {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    ipa-span {
      opacity: 0.6;
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-2xs);
    }

    ol {
      margin-block-start: var(--space-xs);
      list-style: none;

      li {
        padding-inline-start: 1em;
        text-indent: -1em;

        &::before {
          content: counter(list-item);
          display: inline-block;
          inline-size: 1em;
          text-indent: 0;
          font-weight: var(--font-weight-medium);
        }

        + li {
          margin-block-start: var(--space-3xs);
        }
      }
    }

    hr {
      margin-block: var(--space-m);
      border-block-start: 2px solid var(--border);
    }

    prose-content {
      margin-block-start: var(--space-xs);
    }
  }
</style>
