---
import BlogCard from "@/components/BlogCard.astro";
import MetaPage from "@/components/MetaPage.astro";
import Layout from "@/layouts/Layout.astro";
import { getPosts } from "@/lib/content";

const posts = await getPosts();

const categoryMap = new Map<
  string,
  { id: string; name: string; count: number; latestPost: any }
>();

posts.forEach((post) => {
  const cat = post.data?.category;
  if (!cat) return;

  const catName = Array.isArray(cat)
    ? cat[0]?.name
    : typeof cat === "object" && cat !== null
      ? cat.name
      : cat;

  if (!catName) return;
  const catId = String(catName);

  if (!categoryMap.has(catId)) {
    categoryMap.set(catId, {
      id: catId,
      name: String(catName),
      count: 1,
      latestPost: post,
    });
  } else {
    const existing = categoryMap.get(catId)!;
    existing.count += 1;
  }
});

const categories = Array.from(categoryMap.values()).map((cat) => ({
  ...cat,
  href: `/blog/${cat.name}`,
}));

categories.unshift({
  id: "all",
  name: "All",
  count: posts.length,
  latestPost: posts.length > 0 ? posts[0] : null,
  href: "/blog/all",
});
---

<Layout>
  <MetaPage slot="head" title="Blog" />

  <div style="display: flex; flex-direction: column; gap: var(--space-3xl);">
    {
      categories.map((cat) => (
        <div style="display: flex; flex-direction: column; gap: var(--space-s);">
          <a
            href={cat.href}
            style="font-size: var(--step-3); font-weight: var(--font-weight-medium); text-decoration: none;"
          >
            {cat.name}{" "}
            <span style="font-size: var(--step--1); opacity: 0.7; font-weight: var(--font-weight-normal);">
              ({cat.count})
            </span>
          </a>

          {cat.latestPost && <BlogCard post={cat.latestPost} />}
        </div>
      ))
    }
  </div>
</Layout>
